{
  "name": "satellite-agentbase",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/runtime.test.mjs",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build:sites": "bash scripts/build-verified.sh",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "cf:types": "wrangler types --config cloudflare/wrangler.jsonc --include-runtime false cloudflare/worker-configuration.d.ts",
    "cf:types:check": "wrangler types --config cloudflare/wrangler.jsonc --include-runtime false cloudflare/worker-configuration.d.ts --check",
    "cf:check": "npm run cf:types:check && wrangler deploy --config cloudflare/wrangler.jsonc --dry-run --env preview --outdir .wrangler/dry-run",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc --env preview --test-scheduled",
    "cf:migrate:preview": "wrangler d1 migrations apply satellite-preview --config cloudflare/wrangler.jsonc --env preview --remote",
    "cf:migrate:production": "wrangler d1 migrations apply satellite-production --config cloudflare/wrangler.jsonc --env=\"\" --remote",
    "cf:deploy:preview": "wrangler deploy --config cloudflare/wrangler.jsonc --env preview",
    "cf:deploy:production": "wrangler deploy --config cloudflare/wrangler.jsonc --env=\"\""
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "satellite.js": "^6.0.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "^4.120.1"
  },
  "type": "module",
  "displayName": "satellite.agentba.se"
}
